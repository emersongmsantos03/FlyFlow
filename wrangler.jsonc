{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyflow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "GOOGLE_OAUTH",
      "id": "8f57465dc51e4e8a90947279c90f69bb"
    }
  ],
  "d1_databases": [
    {
      "binding": "FLYFLOW_DB",
      "database_name": "flyflow-db",
      "database_id": "95722eaf-ebed-4963-86a7-686399fe8f58"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "flyflow-a97ab"
  }
}
